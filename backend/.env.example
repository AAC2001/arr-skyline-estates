DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — PostgreSQL (recommended). Set USE_SQLITE=True for local dev without Postgres.
USE_SQLITE=True
DB_NAME=arr_skyline
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT (optional override)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Cloudinary (optional — local media used when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default site contact (editable in admin CMS)
DEFAULT_PHONE=+91-XXXXXXXXXX
DEFAULT_WHATSAPP=919XXXXXXXXX
DEFAULT_EMAIL=contact@arrskylineestates.com
DEFAULT_ADDRESS=Hyderabad, Telangana, India
